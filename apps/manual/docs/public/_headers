# Cloudflare Pages headers for the generated manual site.
# The same rules are mirrored in the nginx sample (apps/manual/deploy/nginx.conf.example).
#
# VitePress builds hashed assets under /assets/, so they can be cached forever.
# HTML keeps revalidating so a new deployment is visible immediately.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
