# The harness sandbox is workspace-write: npm's default cache (~/.npm) is outside
# the writable area, so `npm publish` (scripts/release.mjs) would fail with EPERM.
# Keep the cache inside the repo. pnpm-only settings live in pnpm-workspace.yaml:
# npm does not understand `store-dir` and warns about it.
# npm only accepts a full URL or `null` for proxy/https-proxy; an empty value
# triggers "invalid config" warnings, so `null` keeps the user-level proxy off.
proxy=null
https-proxy=null
cache=.npm-cache
fund=false
audit=false
