{
  "name": "zmeow-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "serve": "node apps/serve.mjs",
    "manual": "pnpm -F @bookqaq/zmeow-manual build",
    "manual:dev": "pnpm -F @bookqaq/zmeow-manual dev",
    "manual:preview": "pnpm -F @bookqaq/zmeow-manual preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
